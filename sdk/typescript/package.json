{
  "name": "@control-plane/sdk",
  "version": "0.1.0",
  "description": "Enforcement-point client for the secure AI data governance control plane.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",

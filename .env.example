# Copy to .env and fill in. `make secrets` generates the two keys for you.

# --- Required -------------------------------------------------------------- #

# Seals the audit hash chain. Rotating it invalidates every digest already
# written, so the log stops verifying. Back it up somewhere the database is not.
# How many independent audit chains to spread appends across. One chain means
# one lock, which serialises every decision in the system; 4-8 is the useful
# range. Partitioned by actor, so a single dominant caller does not spread.
# If you set this above 1, take checkpoints on a schedule -- per-stream
# verification cannot notice a whole stream going missing.
CP_AUDIT_PARTITIONS=1

CP_AUDIT_HMAC_KEY=

# Keys deterministic pseudonymisation. Rotating it means a value hashed before
# the rotation no longer matches the same value hashed after, so joins across
# the boundary silently stop working.
CP_REDACTION_HMAC_KEY=

# Required only if a policy uses the 'tokenize' redaction strategy. Unlike the
# keys above this one has NO development fallback: the token is the ciphertext,
# so an ephemeral key would mint tokens that stop reversing at the next restart.
# Back it up separately from the database -- losing it makes every existing token
# permanently irreversible.
CP_TOKENIZATION_KEY=

# Keys retired by rotation, comma-separated, newest first. Read-only: new tokens
# always use the current key. Without these, rotating breaks every token issued
# before it.
CP_TOKENIZATION_PREVIOUS_KEYS=

# --- Database -------------------------------------------------------------- #

CP_DATABASE_URL=postgresql+asyncpg://control_plane:control_plane@localhost:5432/control_plane
POSTGRES_PASSWORD=control_plane

# --- Posture --------------------------------------------------------------- #

# What happens when no policy matches. Keep this at "deny" unless you are
# deliberately running an observation rollout, and change it back afterwards.
CP_DEFAULT_EFFECT=deny

# Whether an internal error denies (true) or propagates (false). An enforcement
# point that allows traffic when the control plane is confused is not a control.
CP_FAIL_CLOSED=true

# --- Data sources ----------------------------------------------------------- #

# Systems the catalog can discover from. See seed/sources.example.yaml. Absent
# is fine: a deployment with no configured sources is the normal starting state,
# and `cpctl catalog discover --adapter ...` works without one.
CP_SOURCES_FILE=sources.yaml

# Credentials the sources file interpolates. Keep them here, not in that file.
WAREHOUSE_DSN=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Service --------------------------------------------------------------- #

CP_ENVIRONMENT=local
CP_LOG_LEVEL=INFO
CP_LOG_JSON=true
CP_PORT=8000
CP_CORS_ORIGINS=http://localhost:5173

# Prometheus scrape endpoint at /metrics. Unauthenticated by convention, so
# restrict the port at the network layer rather than exposing it publicly.
CP_METRICS_ENABLED=true

# Worker processes. Classification is CPU-bound and only partly releases the GIL,
# so one worker is one core. This is the knob that raises decision throughput.
WEB_CONCURRENCY=4

# Mixed into stored API key digests. Optional -- keys carry 192 bits of entropy,
# so they are not brute-forceable without it -- but with one set, a database dump
# alone cannot be used to check guesses offline. Changing it invalidates every
# issued key.
CP_API_KEY_PEPPER=

# Accept unauthenticated requests. Local development only -- the service refuses
# to start with this set in a production environment.
CP_AUTH_DISABLED=false

# Creates one admin key at startup if it does not already exist. Format:
# cpk_<hex>_<secret>. Issue scoped keys with it, then revoke it.
CP_BOOTSTRAP_ADMIN_KEY=

# --- Reference enforcement point ------------------------------------------- #

PEP_PORT=8100
PEP_CONTROL_PLANE_KEY=
# "echo" runs the demo with no provider account; "proxy" forwards upstream.
PEP_UPSTREAM_MODE=echo
PEP_UPSTREAM_URL=https://api.openai.com
PEP_UPSTREAM_KEY=
PEP_DESTINATION=external
PEP_FAIL_CLOSED=true

# How a streamed answer is governed.
#   window  emit tokens a fixed distance behind production, so nothing goes out
#           until everything it could be part of has been seen. Streams, with a
#           blind spot for values longer than the window (which stops the stream
#           with an explicit message rather than corrupting it).
#   buffer  collect the whole answer, govern it, then emit. No blind spot, and no
#           incremental delivery.
# Model URN -> endpoint, for requests a policy routes elsewhere. Keyed by the URN
# the control plane resolves to, so both sides agree on identity without the
# control plane ever holding a credential. A target with no entry here is a
# refusal, not a fallback to the default.
#   {"model://internal/llama-3-70b": {"base_url": "http://llama:8000",
#                                     "model": "llama-3-70b", "api_key": "..."}}
PEP_MODEL_BACKENDS=

PEP_STREAM_MODE=window
PEP_STREAM_WINDOW_CHARS=1024
PEP_STREAM_GOVERN_EVERY=512
